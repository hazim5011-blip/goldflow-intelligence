# GF-AAT V1.6.2 local configuration example (NO credentials)
AAT_SYMBOL=XAUUSD247
# Recommended after ENABLE_GF_AAT_DIRECT_MT5_EYES.bat verifies the exact terminal:
AAT_SOURCE=mt5
AAT_DB=./data/gf_aat.sqlite3
# External context fallback/transport only; never a vote from GoldFlow-derived signals:
AAT_WEBSITE_URL=https://goldflow-intelligence-cf-test.pages.dev
# Required when this PC has multiple MT5 terminals. Set the exact Vantage terminal64.exe path.
# AAT_MT5_TERMINAL_PATH=C:\Program Files\Vantage Markets MT5 Terminal\terminal64.exe
# Set only after explicit calibration proves the broker clock offset.
# Example from the validated Vantage Live 3 setup: 10800
# AAT_DIRECT_BROKER_OFFSET_SECONDS=10800
# Calibration provenance (written by the calibration helper):
# AAT_MT5_CLOCK_VERIFIED_AT_UTC=
# AAT_MT5_CLOCK_VERIFIED_SYMBOL=XAUUSD247
# AAT_MT5_CLOCK_VERIFIED_SERVER=VantageMarkets-Live 3
# Optional authenticated bridge mode (not required for Direct MT5):
# AAT_BRIDGE_URL=http://127.0.0.1:8787
# AAT_BRIDGE_KEY=
# Optional local admin token for mutation endpoints (24+ chars). Do not expose in browser JS.
# AAT_ADMIN_TOKEN=
