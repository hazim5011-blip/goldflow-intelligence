{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goldflow-intelligence",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/release.json"]
  },
  "r2_buckets": [
    {
      "binding": "GOLDFLOW_STORE",
      "bucket_name": "goldflow-forward-ledger"
    }
  ],
  "vars": {
    "BROKER_BRIDGE_URL": "https://bridge.hazim5011.com",
    "VANTAGE_TICK_UTC_OFFSET_SECONDS": "10800",
    "FORWARD_PUBLIC_READ": "false"
  },
  "observability": {
    "enabled": true
  }
}
